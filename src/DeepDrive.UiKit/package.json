{
  "name": "deepdrive-ui-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Tailwind build for the DeepDrive UI Kit design system.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i Styles/input.css -o wwwroot/css/deepdrive-ui.css",
    "build:css:min": "tailwindcss -c tailwind.config.js -i Styles/input.css -o wwwroot/css/deepdrive-ui.min.css --minify",
    "build": "npm run build:css && npm run build:css:min",
    "watch": "tailwindcss -c tailwind.config.js -i Styles/input.css -o wwwroot/css/deepdrive-ui.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "tailwindcss": "^3.4.17"
  }
}
