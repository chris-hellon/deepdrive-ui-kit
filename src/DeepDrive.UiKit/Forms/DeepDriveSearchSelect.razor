@typeparam TItem
@using Microsoft.AspNetCore.Components.Sections

<div class="relative">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="@LabelCss">@Label</label>
    }

    @* Trigger button *@
    <button type="button"
            @onclick="OpenDropdown"
            disabled="@Disabled"
            class="@TriggerCss"
            style="@(InputSize == InputSize.Small ? "height:2.375rem" : InputSize == InputSize.Medium ? "height:2.875rem" : "")">
        <span class="@TriggerLabelCss">
            @(string.IsNullOrEmpty(GetDisplayText(_currentValue)) ? Placeholder ?? "Select..." : GetDisplayText(_currentValue))
        </span>
        @if (_currentValue is not null && !string.IsNullOrWhiteSpace(GetDisplayText(_currentValue)))
        {
            <span @onclick="ClearSelection" @onclick:stopPropagation="true" class="text-neutral-400 hover:text-neutral-600 ml-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
                </svg>
            </span>
        }
        else
        {
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-neutral-400 ml-2 flex-shrink-0">
                <path d="m6 9 6 6 6-6"/>
            </svg>
        }
    </button>

    @if (!string.IsNullOrEmpty(Hint))
    {
        <p class="text-[10px] text-neutral-500 mt-1">@Hint</p>
    }
</div>

@* Full-screen modal for both mobile and desktop.
   Teleported to a root-level SectionOutlet so transformed/blurred ancestors
   (card-lift, backdrop-blur drawers, scroll containers) can't trap the fixed overlay. *@
@if (_showDropdown)
{
    <SectionContent SectionName="DeepDriveOverlays">
    <div class="fixed inset-0 bg-bone/80 backdrop-blur-sm flex items-center justify-center p-4" style="z-index: 99999;" @onclick="CloseDropdown">
        <div class="bg-white w-full max-w-md overflow-y-auto border border-ink/10 shadow-[0_24px_64px_-16px_rgba(20,18,14,0.45)] @(Rounded ? "rounded-2xl" : "")" style="max-height: 80%;" @onclick:stopPropagation="true">
            @* Header with search *@
            <div class="flex justify-between items-center p-4 border-b border-neutral-200 sticky top-0 z-10 bg-white @(Rounded ? "rounded-t-2xl" : "")">
                <div class="flex-1 relative mr-3">
                    <input type="text"
                           @ref="_searchInputRef"
                           value="@_searchTerm"
                           @oninput="OnSearchInput"
                           class="w-full px-4 py-2.5 pl-10 border border-neutral-200 @(Rounded ? "rounded-lg" : "") focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-sm"
                           placeholder="Search..." />
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400">
                        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                    </svg>
                </div>
                <button type="button" @onclick="CloseDropdown" class="w-8 h-8 bg-gray-100 rounded-full flex items-center justify-center hover:bg-gray-200 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gray-600">
                        <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
                    </svg>
                </button>
            </div>
            @if (!string.IsNullOrEmpty(Label))
            {
                <div class="text-xs uppercase tracking-wider text-neutral-500 px-4 py-2 border-b border-neutral-100">@Label</div>
            }

            @* Options list *@
            @{
                var filteredItems = GetFilteredItems();
                var hasItems = false;
            }
            @foreach (var item in filteredItems)
            {
                hasItems = true;
                var displayText = GetDisplayText(item);
                var isSelected = _currentValue is not null && GetDisplayText(_currentValue) == displayText;
                <button type="button"
                        @onclick="() => SelectItem(item)"
                        class="w-full px-4 py-3 text-sm text-left border-b border-neutral-100 last:border-b-0 hover:bg-neutral-50 active:bg-neutral-100 @(isSelected ? "bg-emerald-50 text-emerald-700 font-medium" : "text-neutral-700")">
                    <div class="flex items-center justify-between">
                        <span>@displayText</span>
                        @if (isSelected)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald-600">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        }
                    </div>
                </button>
            }
            @if (!hasItems)
            {
                <div class="px-4 py-8 text-sm text-neutral-400 text-center">No results found</div>
            }
        </div>
    </div>
    </SectionContent>
}

@code {
    [Parameter] public TItem? Value { get; set; }
    [Parameter] public EventCallback<TItem?> ValueChanged { get; set; }
    [Parameter] public IEnumerable<TItem> Items { get; set; } = [];
    [Parameter] public Func<TItem, string>? DisplayTextFunc { get; set; }
    [Parameter] public Func<TItem, string, bool>? FilterFunc { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public InputSize InputSize { get; set; } = InputSize.Medium;
    [Parameter] public bool Rounded { get; set; } = true;
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool ShowScrollHint { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }

    private TItem? _currentValue;
    private string _searchTerm = "";
    private bool _showDropdown;
    private ElementReference _searchInputRef;

    protected override void OnParametersSet()
    {
        // Sync local value with parameter - this ensures we always reflect the parent's value
        _currentValue = Value;
    }

    private string LabelCss => new CssBuilder()
        .Add("block uppercase tracking-wider text-neutral-900")
        .AddIf(() => "mb-1.5 text-sm font-medium", InputSize == InputSize.Small)
        .AddIf(() => "text-sm font-medium mb-2", InputSize == InputSize.Medium)
        .AddIf(() => "text-sm font-medium mb-2", InputSize == InputSize.Large)
        .ToString();
    
    private string TriggerLabelCss
    {
        get
        {
            var css =$"flex-1 text-left truncate {(string.IsNullOrEmpty(GetDisplayText(_currentValue)) ? "text-neutral-400" : "")}";

            css += InputSize switch
            {
                InputSize.Medium => " text-sm",
                InputSize.Small => " text-xs leading-[1.1]",
                _ => string.Empty
            };

            return css;
        }
    }
    private string TriggerCss
    {
        get
        {
            var css = "w-full flex items-center border border-neutral-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 bg-white";

            css += InputSize switch
            {
                InputSize.Large => " px-4 py-3",
                InputSize.Medium => " p-3 text-sm",
                InputSize.Small => " px-3 py-2 text-xs",
                _ => Compact ? " px-4 py-2.5 text-sm" : " px-3 py-2 text-sm"
            };

            if (Rounded) css += " rounded-lg";
            if (Disabled) css += " bg-neutral-100 cursor-not-allowed opacity-60";
            if (!string.IsNullOrEmpty(Class)) css += " " + Class;

            return css;
        }
    }

    private string GetDisplayText(TItem? item)
    {
        if (item is null) return "";
        if (DisplayTextFunc is not null) return DisplayTextFunc(item);
        return item.ToString() ?? "";
    }

    private IEnumerable<TItem> GetFilteredItems()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
            return Items;

        if (FilterFunc is not null)
            return Items.Where(item => FilterFunc(item, _searchTerm));

        // Default: case-insensitive contains on display text
        var term = _searchTerm.Trim().ToLowerInvariant();
        return Items.Where(item => GetDisplayText(item).ToLowerInvariant().Contains(term));
    }

    private void OpenDropdown()
    {
        if (Disabled) return;
        _searchTerm = "";
        _showDropdown = true;
    }

    private void CloseDropdown()
    {
        _showDropdown = false;
        _searchTerm = "";
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? "";
    }

    private async Task SelectItem(TItem item)
    {
        _currentValue = item;
        _searchTerm = "";
        _showDropdown = false;
        await ValueChanged.InvokeAsync(item);
    }

    private async Task ClearSelection()
    {
        _currentValue = default;
        _searchTerm = "";
        await ValueChanged.InvokeAsync(default);
    }
}
