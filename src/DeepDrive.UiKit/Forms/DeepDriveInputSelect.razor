@typeparam T
@typeparam TItem
@using System.Linq.Expressions

@inherits InputSelect<T>

<div>
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@_domId" class="@LabelCss">@Label</label>
    }

    <select id="@Id"
        name="@NameAttributeValue"
        class="@($"{Css} {(string.IsNullOrEmpty(FormatValueAsString(CurrentValue)) ? "has-placeholder" : "")}")"
        disabled="@Disabled"
        value="@FormatValueAsString(CurrentValue)"
        @onchange="OnChangeHandler"
        @attributes="AdditionalAttributes"
        @ref="Element">

    @if (IncludeSelectOption)
    {
        <option value="" disabled="@DisableSelectOption" selected="@string.IsNullOrEmpty(FormatValueAsString(CurrentValue))">
            @if (HideLabel)
            {
                if (!string.IsNullOrEmpty(SelectOptionText))
                {
                    @SelectOptionText
                }
                else if (For != null)
                {
                    <DisplayName For="For"/>
                }
            }
            else
            {
                if (!string.IsNullOrEmpty(SelectOptionText))
                {
                    @SelectOptionText
                }
                else if (For != null)
                {
                    <DisplayName For="For"/>
                }
            }
        </option>
    }
    else
    {
        <option value="" hidden="" />
    }

    @if (IncludeSelectAll)
    {
        <option value="">Select All</option>
    }

    @if (Items.Any())
    {
        foreach (var item in Items)
        {
            var val = GetValue(item)?.ToString();
            <option @key="val" value="@val">
                @GetDisplay(item)
            </option>
        }
    }
    </select>
</div>

@code {
    [Parameter] public Expression<Func<T?>>? For { get; set; }
    [Parameter] public IEnumerable<TItem> Items { get; set; } = new List<TItem>();
    [Parameter] public required Func<TItem, string> GetDisplay { get; set; }
    [Parameter] public required Func<TItem, T> GetValue { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public InputSize InputSize { get; set; } = InputSize.Medium;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? SelectOptionText { get; set; }
    [Parameter] public bool IncludeSelectOption { get; set; } = true;
    [Parameter] public bool DisableSelectOption { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool IncludeSelectAll { get; set; }
    [Parameter] public bool HideLabel { get; set; }
    [Parameter] public bool HideBorder { get; set; }
    [Parameter] public bool Rounded { get; set; }
    [Parameter] public bool FullWidth { get; set; } = true;
    [Parameter] public bool Error { get; set; }
    [Parameter] public string? BackgroundClass { get; set; }

    [Parameter] public EventCallback<T> OnSelectChanged { get; set; }

    private string Id => FieldIdentifier.FieldName;

    private string _domId = null!;

    private string Css
    {
        get
        {
            var bgClass = BackgroundClass ?? "bg-white";
            var classes = $"{bgClass} outline-none focus:outline-none";

            // Border styling - error state takes priority
            if (Error)
            {
                classes += " border-2 border-red-500";
            }
            else if (HideBorder)
            {
                classes += " border border-transparent";
            }
            else
            {
                classes += " border border-gray-200 focus:border-emerald-500 focus:ring-emerald-500";
            }

            if (Rounded) classes += " rounded-lg";
            if (FullWidth) classes += " w-full";

            classes += InputSize switch
            {
                InputSize.Large => " px-4 py-3",
                InputSize.Medium => " p-3 text-sm",
                InputSize.Small => " px-3 py-2 text-xs",
                _ => " p-3 text-sm"
            };

            if (!string.IsNullOrEmpty(CssClass)) classes += " " + CssClass;
            if (!string.IsNullOrEmpty(Class)) classes += " " + Class;

            return classes;
        }
    }

    private string LabelCss => new CssBuilder()
        .Add("block uppercase tracking-wider text-neutral-900")
        .AddIf(() => "mb-1 text-xs font-small", InputSize == InputSize.Small)
        .AddIf(() => "text-sm font-medium mb-2", InputSize == InputSize.Medium)
        .AddIf(() => "text-sm font-medium mb-2", InputSize == InputSize.Large)
        .ToString();
    
    // Dummy field used when ValueExpression is not provided (e.g., when using Value/ValueChanged in loops)
    private T? _dummyValue;
    private bool _usingDummyExpression;

    public override Task SetParametersAsync(ParameterView parameters)
    {
        // If ValueExpression is not provided, use a dummy expression to satisfy InputBase requirements
        if (!parameters.TryGetValue<Expression<Func<T?>>>(nameof(ValueExpression), out _))
        {
            _usingDummyExpression = true;
            ValueExpression = () => _dummyValue;
        }
        return base.SetParametersAsync(parameters);
    }

    protected override void OnInitialized()
    {
        _domId = $"{Id}-{Guid.NewGuid():N}";

        if (_usingDummyExpression)
        {
            FieldIdentifier = new FieldIdentifier(new object(), Guid.NewGuid().ToString());
        }

        base.OnInitialized();
    }
    
    protected override bool TryParseValueFromString(string? value, out T result, out string validationErrorMessage)
    {
        if (typeof(T).IsEnum)
        {
            if (Enum.TryParse(typeof(T), value, out var enumValue))
            {
                result = (T) enumValue;
                validationErrorMessage = string.Empty;
                return true;
            }
        }

        if (typeof(T) == typeof(Guid))
        {
            if (Guid.TryParse(value, out var guid))
            {
                result = (T) (object) guid;
                validationErrorMessage = string.Empty;
                return true;
            }
        }

        if (typeof(T) == typeof(Guid?))
        {
            if (string.IsNullOrEmpty(value))
            {
                result = default!;
                validationErrorMessage = string.Empty;
                return true;
            }

            if (Guid.TryParse(value, out var guid))
            {
                result = (T) (object) (Guid?) guid;
                validationErrorMessage = string.Empty;
                return true;
            }
        }

        if (typeof(T) == typeof(int))
        {
            if (int.TryParse(value, out var intVal))
            {
                result = (T) (object) intVal;
                validationErrorMessage = string.Empty;
                return true;
            }
        }

        if (typeof(T) == typeof(int?))
        {
            if (string.IsNullOrEmpty(value))
            {
                result = default!;
                validationErrorMessage = string.Empty;
                return true;
            }

            if (int.TryParse(value, out var intVal))
            {
                result = (T) (object) (int?) intVal;
                validationErrorMessage = string.Empty;
                return true;
            }
        }

        if (typeof(T) == typeof(string))
        {
            result = (T) (object) value!;
            validationErrorMessage = string.Empty;
            return true;
        }

        result = default!;
        validationErrorMessage = $"The selected value '{value}' is not valid.";
        return false;
    }

    private async Task OnChangeHandler(ChangeEventArgs e)
    {
        if (BindConverter.TryConvertTo<T>(e.Value?.ToString(), CultureInfo.CurrentCulture, out var value))
        {
            CurrentValue = value;
            await ValueChanged.InvokeAsync(CurrentValue);

            if (OnSelectChanged.HasDelegate)
            {
                await OnSelectChanged.InvokeAsync(CurrentValue);
            }
        }
    }
}