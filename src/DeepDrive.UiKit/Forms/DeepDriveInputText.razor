@using System.Linq.Expressions
@inherits InputText

<div>
       @if (!string.IsNullOrEmpty(Label))
       {
              <label for="@_domId" class="block mb-2 uppercase tracking-wider text-sm font-medium text-neutral-900">@Label</label>
       }

       @if (StartIcon is not null || EndIcon is not null)
       {
              <div class="relative">
                     @if (StartIcon is not null)
                     {
                            <div class="absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400 pointer-events-none">
                                   @StartIcon
                            </div>
                     }
                     <input id="@_domId"
                            name="@NameAttributeValue"
                            type="@InputType.ToString().ToLower()"
                            class="@Css"
                            placeholder="@Placeholder"
                            value="@CurrentValue"
                            disabled="@Disabled"
                            @oninput="HandleInput"
                            @onkeyup="HandleKeyUp"
                            @attributes="AdditionalAttributes"
                            @ref="Element"/>
                     @if (EndIcon is not null)
                     {
                            <div class="absolute right-3 top-1/2 -translate-y-1/2 text-neutral-400 pointer-events-none">
                                   @EndIcon
                            </div>
                     }
              </div>
       }
       else
       {
              <input id="@_domId"
                     name="@NameAttributeValue"
                     type="@InputType.ToString().ToLower()"
                     class="@Css"
                     placeholder="@Placeholder"
                     value="@CurrentValue"
                     disabled="@Disabled"
                     @oninput="HandleInput"
                     @onkeyup="HandleKeyUp"
                     @attributes="AdditionalAttributes"
                     @ref="Element"/>
       }

       @if (For is not null)
       {
              <CustomValidationMessage For="@For"/>
       }

       @if (!string.IsNullOrEmpty(Hint))
       {
              <p class="mt-1 text-xs text-neutral-500">@Hint</p>
       }
</div>

@code {
       [Parameter] public Expression<Func<string?>>? For { get; set; }
       [Parameter] public string? Label { get; set; }
       [Parameter] public string? Placeholder { get; set; }
       [Parameter] public string? Hint { get; set; }
       [Parameter] public InputTextType InputType { get; set; } = InputTextType.Text;
       [Parameter] public InputSize InputSize { get; set; } = InputSize.Medium;
       [Parameter] public string? Class { get; set; }
       [Parameter] public bool Disabled { get; set; }
       [Parameter] public bool HideBorder { get; set; }
       [Parameter] public bool Rounded { get; set; }
       [Parameter] public string? BackgroundClass { get; set; }
       [Parameter] public RenderFragment? StartIcon { get; set; }
       [Parameter] public RenderFragment? EndIcon { get; set; }

       [Parameter] public EventCallback<ChangeEventArgs> OnInputChanged { get; set; }
       [Parameter] public EventCallback OnKeyUp { get; set; }
       [Parameter] public EventCallback OnEnter { get; set; }

       private string Id => FieldIdentifier.FieldName;
       private string _domId = null!;

       private bool HasStartIcon => StartIcon is not null;
       private bool HasEndIcon => EndIcon is not null;

       private string Css => new CssBuilder()
              .Add($"w-full {BackgroundClass ?? "bg-white"} placeholder-neutral-400 outline-none [&.invalid]:border-red-500 [&.invalid]:ring-red-500 focus:outline-none focus:border-emerald-500 focus:ring-emerald-500")
              .AddIf(() => "border border-transparent", HideBorder)
              .AddIf(() => "border border-gray-200", !HideBorder)
              .AddIf(() => "rounded-lg", Rounded)
              // Large size
              .AddIf(() => "py-3", InputSize == InputSize.Large)
              .AddIf(() => "pl-10", InputSize == InputSize.Large && HasStartIcon)
              .AddIf(() => "pl-4", InputSize == InputSize.Large && !HasStartIcon)
              .AddIf(() => "pr-10", InputSize == InputSize.Large && HasEndIcon)
              .AddIf(() => "pr-4", InputSize == InputSize.Large && !HasEndIcon)
              // Medium size
              .AddIf(() => "py-3 text-sm", InputSize == InputSize.Medium)
              .AddIf(() => "pl-9", InputSize == InputSize.Medium && HasStartIcon)
              .AddIf(() => "pl-3", InputSize == InputSize.Medium && !HasStartIcon)
              .AddIf(() => "pr-9", InputSize == InputSize.Medium && HasEndIcon)
              .AddIf(() => "pr-3", InputSize == InputSize.Medium && !HasEndIcon)
              // Small size
              .AddIf(() => "py-2 text-xs", InputSize == InputSize.Small)
              .AddIf(() => "pl-8", InputSize == InputSize.Small && HasStartIcon)
              .AddIf(() => "pl-3", InputSize == InputSize.Small && !HasStartIcon)
              .AddIf(() => "pr-8", InputSize == InputSize.Small && HasEndIcon)
              .AddIf(() => "pr-3", InputSize == InputSize.Small && !HasEndIcon)
              .Add(CssClass)
              .Add(Class)
              .ToString();

       protected override void OnInitialized()
       {
              _domId = $"{Id}-{Guid.NewGuid():N}";

              if (ValueExpression == null)
              {
                     FieldIdentifier = new FieldIdentifier(new object(), Guid.NewGuid().ToString());
              }

              base.OnInitialized();
       }

       private async Task HandleInput(ChangeEventArgs e)
       {
              CurrentValue = e.Value?.ToString();

              if (OnInputChanged.HasDelegate)
                     await OnInputChanged.InvokeAsync(e);
       }

       private async Task HandleKeyUp(KeyboardEventArgs e)
       {
              if (OnKeyUp.HasDelegate)
                     await OnKeyUp.InvokeAsync();

              if (e is { Key: "Enter", ShiftKey: false } && OnEnter.HasDelegate)
                     await OnEnter.InvokeAsync();
       }

}