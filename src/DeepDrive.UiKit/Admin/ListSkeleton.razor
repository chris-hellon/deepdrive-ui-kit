<div class="space-y-3 @Class">
    @for (var i = 0; i < RowCount; i++)
    {
        <div class="bg-white p-4 border border-ink/10 animate-pulse">
            <div class="flex items-center gap-4">
                @if (ShowAvatar)
                {
                    <div class="w-12 h-12 bg-bone2 rounded-full flex-shrink-0"></div>
                }
                <div class="flex-1 min-w-0">
                    <div class="h-4 w-48 bg-bone2 mb-2"></div>
                    <div class="h-3 w-32 bg-bone2"></div>
                </div>
                @if (ShowActions)
                {
                    <div class="flex items-center gap-2 flex-shrink-0">
                        <div class="h-8 w-16 bg-bone2"></div>
                        <div class="h-8 w-8 bg-bone2"></div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int RowCount { get; set; } = 5;
    [Parameter] public bool ShowAvatar { get; set; }
    [Parameter] public bool ShowActions { get; set; } = true;
    [Parameter] public string? Class { get; set; }
}
