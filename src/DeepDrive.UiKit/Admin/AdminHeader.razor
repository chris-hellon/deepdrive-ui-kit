@inject IJSRuntime Js

<div class="bg-white border-b border-ink/10 sticky top-0 transition-all duration-200 @(IsScrolled ? "px-4 py-2" : "px-4 md:px-6 py-3 md:py-4")">
    <div class="flex items-center gap-3">
        @if (!string.IsNullOrWhiteSpace(BackUrl))
        {
            <a href="@BackUrl" class="@BackButtonCss">
                <svg xmlns="http://www.w3.org/2000/svg" width="@(IsScrolled ? "16" : "18")" height="@(IsScrolled ? "16" : "18")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </a>
        }
        else if (ShowBackButton)
        {
            <button @onclick="GoBack" class="@BackButtonCss">
                <svg xmlns="http://www.w3.org/2000/svg" width="@(IsScrolled ? "16" : "18")" height="@(IsScrolled ? "16" : "18")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>
        }
        <div class="flex-1 min-w-0">
            <h1 class="@TitleCss truncate">@Title</h1>
            @if (!string.IsNullOrWhiteSpace(Subtitle) && !IsScrolled)
            {
                <p class="ed-micro text-taupe mt-0.5">@Subtitle</p>
            }
        </div>
        @if (HeaderActions is not null)
        {
            <div class="flex items-center gap-2 flex-shrink-0">
                @HeaderActions
            </div>
        }
    </div>
    @if (HeaderContent is not null && !IsScrolled)
    {
        @HeaderContent
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? BackUrl { get; set; }
    [Parameter] public bool ShowBackButton { get; set; } = true;
    [Parameter] public RenderFragment? HeaderActions { get; set; }
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public bool IsScrolled { get; set; }

    private string BackButtonCss => IsScrolled
        ? "w-8 h-8 flex items-center justify-center text-taupe hover:text-ink hover:bg-bone2 transition-colors flex-shrink-0"
        : "w-9 h-9 flex items-center justify-center text-taupe hover:text-ink hover:bg-bone2 transition-colors flex-shrink-0";

    private string TitleCss => IsScrolled
        ? "ed-display text-base text-ink leading-none"
        : "ed-display text-xl md:text-2xl text-ink leading-none";

    private async Task GoBack() => await Js.InvokeVoidAsync("history.back");
}
