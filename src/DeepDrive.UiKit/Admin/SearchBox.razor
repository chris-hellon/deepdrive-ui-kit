<div class="flex gap-2">
    <DeepDriveInputText @bind-Value="Value"
                        Placeholder="@Placeholder"
                        OnInputChanged="OnInput"
                        BackgroundClass="bg-white"
                        InputSize="InputSize.Small"
                        Class="flex-1" />
    <button @onclick="OnRefresh" class="w-9 h-9 flex items-center justify-center bg-white border border-ink/10 text-taupe hover:text-ink hover:bg-bone2 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
            <path d="M3 3v5h5"/>
            <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
            <path d="M16 16h5v5"/>
        </svg>
    </button>
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Search...";
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback OnSearch { get; set; }

    private async Task OnInput(ChangeEventArgs e)
    {
        await ValueChanged.InvokeAsync(Value);
    }
}
