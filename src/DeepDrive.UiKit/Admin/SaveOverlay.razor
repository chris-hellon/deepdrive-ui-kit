@if (Visible)
{
    <div class="fixed inset-0 z-[9999] flex items-center justify-center bg-ink/40 backdrop-blur-sm">
        <div class="bg-white border border-ink/10 shadow-[0_24px_64px_-16px_rgba(20,18,14,0.45)] p-6 flex flex-col items-center gap-4 min-w-[200px]">
            <div class="relative w-10 h-10">
                <div class="absolute inset-0 border-4 border-ink/10 rounded-full"></div>
                <div class="absolute inset-0 border-4 border-emerald-500 rounded-full border-t-transparent animate-spin"></div>
            </div>
            <span class="text-sm font-medium text-ink">@Message</span>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Message { get; set; } = "Saving...";
}
